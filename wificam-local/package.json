{
  "name": "wificam-local",
  "version": "0.1.0",
  "description": "WyreFi Cam: webcam privada para iPhone e OBS com WebRTC local",
  "license": "MIT",
  "engines": {
    "node": ">=24 <25"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx server/index.ts --dev",
    "build": "npm run typecheck && vite build && tsc -p tsconfig.server.json",
    "start": "node build/server/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "lint": "eslint .",
    "setup": "node scripts/setup.mjs",
    "diagnose": "node scripts/diagnose.mjs",
    "privacy": "node scripts/privacy-check.mjs",
    "verify": "npm run lint && npm run test && npm run build && npm run privacy",
    "test:smoke": "npm run build && node scripts/smoke.mjs"
  },
  "dependencies": {
    "qrcode": "^1.5.4",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "@types/qrcode": "^1.5.5",
    "@types/ws": "^8.18.1",
    "eslint": "^10.13.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
